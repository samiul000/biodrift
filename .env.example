# BioDrift Configuration
USE_MOCK_DATA=false

# Database
DATABASE_URL="file:./biodrift.db"

# Bright Data Scraper Studio (created via bdata scraper create)
BRIGHTDATA_API_TOKEN=your_api_token_here

# Collector IDs (real c_xxxxxx IDs from Bright Data)
BRIGHTDATA_COLLECTOR_CW=c_xxxxxx
BRIGHTDATA_COLLECTOR_ISRCTN=c_xxxxxx
BRIGHTDATA_COLLECTOR_CRUK=c_xxxxxx
BRIGHTDATA_COLLECTOR_DRUGS=c_xxxxxx
